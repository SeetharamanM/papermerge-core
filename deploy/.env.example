# Copy to .env and change every value marked CHANGE_ME.
# Generate secrets with:  openssl rand -hex 32

# --- Security (required) ---
SECRET_KEY=CHANGE_ME
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# --- Database (required) ---
DB_USER=papermerge
DB_NAME=papermerge
# Use letters and digits only (it is embedded in a connection URL)
DB_PASSWORD=CHANGE_ME

# --- OCR ---
# Tesseract languages baked into the image at build time
# (space separated, English "eng" is always included)
OCR_LANGUAGES="deu fra spa"
# Default OCR language for new documents (one of the above, or eng)
OCR_DEFAULT_LANGUAGE=eng

# --- General ---
TIMEZONE=Europe/Berlin

# --- Networking ---
# Port the web UI listens on: http://<server>:HTTP_PORT
HTTP_PORT=12000
# Set to 127.0.0.1 when running behind the bundled Caddy (https profile)
# or another reverse proxy, so the plain HTTP port is not public.
HTTP_BIND=0.0.0.0

# Public domain name, only used with:  docker compose --profile https up -d
DOMAIN=dms.example.com

# Optional: run a prebuilt image instead of building from this repository
# PAPERMERGE_IMAGE=papermerge/papermerge:3.0.2
